import vm NativeNavigationViewModel

Window(accent: .green) {
    IconSegmentedControl(id: "society-navigation") {
        IconButton(id: "environment", iconName: "workloads", accessibilityName: "Environment", checked: vm.environmentActive, pointerFocusVisible: false, onClick: vm.environment)
        IconButton(id: "tasks", iconName: "toolwindowrun", iconSource: vm.iconSource, accessibilityName: "Tasks", checked: vm.tasksActive, pointerFocusVisible: false, onClick: vm.tasks)
        IconButton(id: "library", iconName: "asset-library", iconSource: vm.iconSource, accessibilityName: "Library", checked: vm.libraryActive, pointerFocusVisible: false, onClick: vm.library)
        IconButton(id: "space", iconName: "toolwindownewUI", iconSource: vm.iconSource, accessibilityName: "Space", checked: vm.spaceActive, pointerFocusVisible: false, onClick: vm.space)
        IconButton(id: "apps", iconName: "application-alt", iconSource: vm.iconSource, accessibilityName: "Apps", checked: vm.appsActive, pointerFocusVisible: false, onClick: vm.apps)
        IconButton(id: "service", iconName: "usd", iconSource: vm.iconSource, accessibilityName: "Service", checked: vm.serviceActive, pointerFocusVisible: false, onClick: vm.service)
        IconButton(id: "community", iconName: "ppWeb", iconSource: vm.iconSource, accessibilityName: "Community", checked: vm.communityActive, pointerFocusVisible: false, onClick: vm.community)
        IconButton(id: "learning", iconName: "cwmUsers", iconSource: vm.iconSource, accessibilityName: "Learning", checked: vm.learningActive, pointerFocusVisible: false, onClick: vm.learning)
        IconButton(id: "hosting", iconName: "kernel", iconSource: vm.iconSource, accessibilityName: "Hosting", checked: vm.hostingActive, pointerFocusVisible: false, onClick: vm.hosting)
    }
}
