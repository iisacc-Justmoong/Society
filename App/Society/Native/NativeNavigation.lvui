import vm NativeNavigationViewModel

Window(accent: .green) {
    IconSegmentedControl(id: "society-navigation") {
        IconButton(id: "environment", iconName: "workloads", accessibilityName: "Workspace", checked: vm.environmentActive, pointerFocusVisible: false, onClick: vm.environment)
        IconButton(id: "tasks", iconName: "toolwindowrun", iconSource: vm.iconSource, accessibilityName: "Tasks", checked: vm.tasksActive, pointerFocusVisible: false, onClick: vm.tasks)
        IconButton(id: "library", iconName: "asset-library", iconSource: vm.iconSource, accessibilityName: "Library", checked: vm.libraryActive, pointerFocusVisible: false, onClick: vm.library)
        IconButton(id: "space", iconName: "toolwindownewUI", iconSource: vm.iconSource, accessibilityName: "Space", checked: vm.spaceActive, pointerFocusVisible: false, onClick: vm.space)
        IconButton(id: "browse", iconName: "webApp", iconSource: vm.iconSource, accessibilityName: "Browse", checked: vm.browseActive, pointerFocusVisible: false, onClick: vm.browse)
        IconButton(id: "people", iconName: "cwmUsers", iconSource: vm.iconSource, accessibilityName: "People", checked: vm.peopleActive, pointerFocusVisible: false, onClick: vm.people)
        IconButton(id: "hosting", iconName: "webServer", iconSource: vm.iconSource, iconSize: 12, width: 22, accessibilityName: "Hosting", checked: vm.hostingActive, pointerFocusVisible: false, onClick: vm.hosting)
    }
}
