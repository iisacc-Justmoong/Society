cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED SOCIETY_PHOTO_PLATFORM_FILE)
    message(FATAL_ERROR "SOCIETY_PHOTO_PLATFORM_FILE is required")
endif()
include("${SOCIETY_PHOTO_PLATFORM_FILE}")
function(check_platform name win store apple ios android wasm expected)
    set(WIN32 "${win}")
    set(WINDOWS_STORE "${store}")
    set(APPLE "${apple}")
    set(IOS "${ios}")
    set(ANDROID "${android}")
    set(EMSCRIPTEN "${wasm}")
    society_native_photo_enabled(actual)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
    society_native_photo_platform_components(sources libraries)
    if(expected AND win)
        if(NOT "App/Society/Native/PhotoNativeRegionWindows.cpp" IN_LIST sources OR
           NOT "App/Society/Native/PhotoWindowsDriver.cpp" IN_LIST sources OR
           "App/Society/Native/PhotoNativeRegion.mm" IN_LIST sources OR NOT "user32" IN_LIST libraries)
            message(FATAL_ERROR "${name}: Windows host sources or system library were not selected correctly")
        endif()
    elseif(expected AND apple AND ios)
        if(NOT "App/Society/Native/PhotoNativeRegionIOS.mm" IN_LIST sources OR
           "App/Society/Native/PhotoNativeRegion.mm" IN_LIST sources OR
           "App/Society/Native/PhotoNativeRegionWindows.cpp" IN_LIST sources OR
           NOT "-framework UIKit" IN_LIST libraries)
            message(FATAL_ERROR "${name}: iOS host sources or framework were not selected correctly")
        endif()
    elseif(expected AND apple)
        if(NOT "App/Society/Native/PhotoNativeRegion.mm" IN_LIST sources OR
           "App/Society/Native/PhotoNativeRegionWindows.cpp" IN_LIST sources OR
           NOT "-framework AppKit" IN_LIST libraries)
            message(FATAL_ERROR "${name}: macOS host sources or framework were not selected correctly")
        endif()
    elseif(sources OR libraries)
        message(FATAL_ERROR "${name}: an unsupported host selected native photo sources")
    endif()
endfunction()
check_platform("Windows desktop" TRUE FALSE FALSE FALSE FALSE FALSE TRUE)
check_platform("Windows Store" TRUE TRUE FALSE FALSE FALSE FALSE FALSE)
check_platform("macOS" FALSE FALSE TRUE FALSE FALSE FALSE TRUE)
check_platform("iOS" FALSE FALSE TRUE TRUE FALSE FALSE TRUE)
check_platform("Linux" FALSE FALSE FALSE FALSE FALSE FALSE FALSE)
check_platform("Android" FALSE FALSE FALSE FALSE TRUE FALSE FALSE)
check_platform("WebAssembly" FALSE FALSE FALSE FALSE FALSE TRUE FALSE)
