if(NOT DEFINED SOCIETY_ACCOUNT_PLATFORM_FILE)
    message(FATAL_ERROR "SOCIETY_ACCOUNT_PLATFORM_FILE is required")
endif()
include("${SOCIETY_ACCOUNT_PLATFORM_FILE}")

function(check_platform name win apple ios android wasm expected)
    set(WIN32 "${win}")
    set(APPLE "${apple}")
    set(IOS "${ios}")
    set(ANDROID "${android}")
    set(EMSCRIPTEN "${wasm}")
    society_native_account_enabled(actual)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected ${expected}, got ${actual}")
    endif()
endfunction()

check_platform("Windows" TRUE FALSE FALSE FALSE FALSE TRUE)
check_platform("macOS" FALSE TRUE FALSE FALSE FALSE TRUE)
check_platform("iOS" FALSE TRUE TRUE FALSE FALSE TRUE)
check_platform("Linux" FALSE FALSE FALSE FALSE FALSE FALSE)
check_platform("Android" FALSE FALSE FALSE TRUE FALSE FALSE)
check_platform("WebAssembly" FALSE FALSE FALSE FALSE TRUE FALSE)
